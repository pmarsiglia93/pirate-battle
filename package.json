{
  "name": "pirate-battle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . && prettier --check --no-error-on-unmatched-pattern src tests scripts *.json *.ts *.js *.md docs/PLAN.md reports/performance.md",
    "format": "prettier --write --no-error-on-unmatched-pattern src tests scripts *.json *.ts *.js *.md docs/PLAN.md reports/performance.md",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.12.0",
    "msw": "^2.11.0",
    "pixi.js": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
